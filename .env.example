# Copy to .env and fill in. Never commit .env.

# Where datasets are written (git-ignored)
AEROLISA_DATA_DIR=./data

# OpenSky Network: OAuth2 client credentials (create an API client on your OpenSky account page).
# Either point to the downloaded credentials file...
OPENSKY_CREDENTIALS_FILE=./credentials.json
# ...or set the values directly.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_DAILY_CREDIT_BUDGET=3000

# Experiments
MLFLOW_TRACKING_URI=http://localhost:5000

# Copilot (M10). Only public data and simulated objects are ever sent.
LLM_API_KEY=
LLM_MODEL=
